# Set this to your database connection URL. Replace all placeholder values locally.
DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:5432/<database>

# For MySQL
# DATABASE_URL=mysql+mysqlconnector://username:password@host.docker.internal:3306/test_db

# For MSSQL
# DATABASE_URL=mssql+pyodbc://username:password@host.docker.internal:1433/test_db?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
